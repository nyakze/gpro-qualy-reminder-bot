# =======================
# Onboarding
# =======================
onboard-group-title = 🏁 <b>ग्रुप चयन</b>

    वैयक्तिकृत रेस लिंक्स प्राप्त करने के लिए अपना GPRO ग्रुप चुनें:

    एक सामान्य ग्रुप चुनें या अपना स्वयं का दर्ज करें:

onboard-group-custom = 🏁 <b>ग्रुप चयन (वैकल्पिक)</b>

    अपना ग्रुप इनमें से किसी एक फॉर्मेट में दर्ज करें:
    • <b>E</b> (Elite)
    • <b>M3</b> (Master 3)
    • <b>P15</b> (Pro 15)
    • <b>A42</b> (Amateur 42)
    • <b>R11</b> (Rookie 11)

    नंबर 1-3 अंकों के हो सकते हैं।

    💡 <i>आपकी GPRO वेबसाइट भाषा आपकी बॉट भाषा से मेल खाने के लिए सेट कर दी गई है। आप इसे बाद में /settings में बदल सकते हैं</i>

onboard-complete = ✅ <b>सेटअप पूर्ण!</b>

    🏁 <b>GPRO बॉट तैयार है!</b>

    <b>उपलब्ध कमांड्स:</b>
    /status - अगली रेस
    /calendar - पूरा सीज़न
    /next - अगला सीज़न
    /settings - प्राथमिकताएं

    💡 <i>आप /settings का उपयोग करके कभी भी इन सेटिंग्स को बदल सकते हैं</i>

onboard-complete-with-group = ✅ <b>सेटअप पूर्ण!</b>

    ग्रुप: <b>{ $group }</b>

    🏁 <b>GPRO बॉट तैयार है!</b>

    <b>उपलब्ध कमांड्स:</b>
    /status - अगली रेस
    /calendar - पूरा सीज़न
    /next - अगला सीज़न
    /settings - प्राथमिकताएं

# =======================
# Settings
# =======================
settings-title = ⚙️ <b>सेटिंग्स</b>

    अपनी प्राथमिकताएं कॉन्फ़िगर करें:

settings-language-title = 🌍 <b>भाषा सेटिंग्स</b>

    वर्तमान: { $language }

    GPRO रेस लिंक्स के लिए अपनी पसंदीदा भाषा चुनें:

ui-lang-menu-title = 💬 <b>बॉट भाषा</b>

    बॉट इंटरफेस भाषा चुनें:

settings-group-title = 🏁 <b>ग्रुप सेटिंग्स</b>

    वर्तमान ग्रुप: <b>{ $group }</b>

    अपना ग्रुप इनमें से किसी एक फॉर्मेट में दर्ज करें:
    • <b>E</b> (Elite)
    • <b>M3</b> (Master 3)
    • <b>P15</b> (Pro 15)
    • <b>A42</b> (Amateur 42)
    • <b>R11</b> (Rookie 11)

    नंबर 1-3 अंकों के हो सकते हैं।

settings-group-set = ✅ <b>ग्रुप सेट किया गया: { $group }</b>

    रेस और रिप्ले सूचनाओं में आपके ग्रुप के सीधे लिंक्स शामिल होंगे!

settings-notifications-title = 🔔 <b>सूचना सेटिंग्स</b>

    सूचनाओं को चालू/बंद करने के लिए क्लिक करें:
    ✅ = सक्षम | ❌ = अक्षम

    ℹ️ <i>ये सभी रेस के लिए ग्लोबल स्विच हैं। किसी विशिष्ट रेस को अक्षम करने के लिए सूचनाओं में 'क्वालीफाइंग पूर्ण' बटन का उपयोग करें।</i>

settings-custom-notif-title = ⏱️ <b>कस्टम सूचनाएं</b>

    अपनी स्वयं की सूचना समय निर्धारित करें ({ $min }m - { $max }h क्वालीफाइंग बंद होने से पहले)।

    आप अधिकतम 2 कस्टम सूचनाएं रख सकते हैं।

    इसे सेट या संपादित करने के लिए स्लॉट पर क्लिक करें।

settings-custom-notif-edit = ⏱️ <b>कस्टम सूचना { $slot }</b>{ $current }

    एक प्रीसेट समय चुनें या कस्टम समय दर्ज करें:

settings-custom-notif-current = वर्तमान:

settings-custom-notif-input = ⏱️ <b>कस्टम सूचना { $slot }</b>

    अपना कस्टम सूचना समय दर्ज करें।

    <b>स्वीकृत फॉर्मेट:</b>
    • <code>20m</code> या <code>45 minutes</code> (20m-70h)
    • <code>2h</code> या <code>12 hours</code>
    • <code>1h 30m</code> या <code>2h30m</code>

    <b>उदाहरण:</b>
    • <code>20m</code> - 20 मिनट पहले
    • <code>6h</code> - 6 घंटे पहले
    • <code>1h 30m</code> - 1 घंटा 30 मिनट पहले

