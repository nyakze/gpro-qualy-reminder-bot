# =======================
# Time Formatting
# =======================
# Weekday abbreviations (2-letter)
weekday-mon = सो
weekday-tue = मं
weekday-wed = बु
weekday-thu = गु
weekday-fri = शु
weekday-sat = श
weekday-sun = र

time-minutes = { $minutes ->
    [one] { $minutes } मिनट
   *[other] { $minutes } मिनट
}
time-hours = { $hours ->
    [one] { $hours } घंटा
   *[other] { $hours } घंटे
}
time-hours-minutes = { $hours ->
    [one] { $hours } घंटा
   *[other] { $hours } घंटे
} { $minutes ->
    [one] { $minutes } मिनट
   *[other] { $minutes } मिनट
}
time-hours-minutes-short = { $hours }h{ $minutes }m
time-hours-short = { $hours }h
time-minutes-short = { $minutes }m
time-days-hours-short = { $days }d{ $hours }h
time-days-hours-minutes-short = { $days }d{ $hours }h{ $minutes }m
time-days = { $days ->
    [one] { $days } दिन
   *[other] { $days } दिन
}
time-days-hours = { $days ->
    [one] { $days } दिन
   *[other] { $days } दिन
} { $hours ->
    [one] { $hours } घंटा
   *[other] { $hours } घंटे
}
time-months = { $months ->
    [one] { $months } महीना
   *[other] { $months } महीने
}
time-months-days = { $months ->
    [one] { $months } महीना
   *[other] { $months } महीने
} { $days ->
    [one] { $days } दिन
   *[other] { $days } दिन
}

